# Server
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=postgres-service
DB_PORT=5432
DB_NAME=neet_insights

# Redis
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password
REDIS_DB=0

# CORS
ALLOWED_ORIGINS=https://deepinsightsneet.com,https://www.deepinsightsneet.com

# Application
MAX_CONNECTIONS=500
REQUEST_TIMEOUT=30000
